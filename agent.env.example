# Copy to agent.env in the repo root and edit. agent.env is gitignored, keep the
# API key there and never in source. Java loads it automatically from the
# working directory, both in IntelliJ and through scripts\run.ps1.

# --- Reader -----------------------------------------------------------------
READER_HOST=192.168.1.100
READER_PORT=9090
READER_NAME=Device1
# READER_MODE=simulator          # fake tags, no R400 needed

# --- Local diagnostics / manual control -------------------------------------
# Cloud control is outbound polling. Keep this bound to localhost unless a
# trusted LAN operator explicitly needs the legacy /scan/start endpoints.
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_CONTROL_PORT=8443
# AGENT_API_KEY=                 # optional x-api-key on local /scan/* endpoints
# AGENT_TLS_KEYSTORE=certs/agent-keystore.p12
# AGENT_TLS_KEYSTORE_PASSWORD=changeit
# AGENT_TLS_SAN=ip:192.168.1.10  # extra names on the generated certificate

# --- Middleware and outbound commands ---------------------------------------
MIDDLEWARE_BASE_URL=https://middleware.example.com
MIDDLEWARE_API_KEY=replace-me
# UUID of this reader from the cloud RFID Readers screen.
READER_ID=replace-with-rfid-reader-uuid
# MIDDLEWARE_READS_PATH=/api/v1/epc-scan-processing/sessions/{sessionId}/reads
# MIDDLEWARE_TIMEOUT_MS=5000
# COMMAND_POLL_PATH=/api/v1/reader-agent/commands/poll
# COMMAND_ACK_PATH=/api/v1/reader-agent/commands/{commandId}/ack
# Must exceed the middleware long-poll duration (20 seconds by default).
# COMMAND_POLL_REQUEST_TIMEOUT_MS=30000
# COMMAND_RETRY_DELAY_MS=1000

# --- Batching ---------------------------------------------------------------
# EPC_BATCH_SIZE=200             # 1..1000, the middleware caps a batch at 1000
# EPC_FLUSH_INTERVAL_MS=1000
# EPC_MAX_PENDING=50000
# EPC_STOP_FLUSH_TIMEOUT_MS=15000 # STOP fails instead of closing with unsent EPCs

# --- Policy -----------------------------------------------------------------
# SCAN_START_CONFLICT=takeover   # takeover | reject
# READER_WATCHDOG_INTERVAL_MS=5000
